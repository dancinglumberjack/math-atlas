{
  "name": "math-atlas",
  "version": "1.0.0",
  "private": true,
  "description": "A browser-based visual mathematics learning library for middle and high school students.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "test": "node --test tests/*.test.mjs tests/calculator.test.cjs",
    "test:browser": "node tests/browser.mjs",
    "serve": "node scripts/serve.mjs",
    "package:site": "node scripts/package-site.mjs"
  },
  "devDependencies": { "playwright": "1.62.1" }
}
