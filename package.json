{
  "name": "math-atlas",
  "version": "1.5.0",
  "private": true,
  "description": "Visual mathematics adventures, interactive lessons, and gentle student rewards from early counting to introductory college explorations.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "test": "node --test tests/*.test.mjs tests/calculator.test.cjs",
    "test:browser": "node tests/browser.mjs",
    "serve": "node scripts/serve.mjs",
    "package:site": "node scripts/package-site.mjs",
    "test:adventure": "node tests/adventure-browser.mjs",
    "test:school-year": "node tests/school-year-browser.mjs",
    "test:primary": "node tests/primary-browser.mjs",
    "test:upper": "node tests/upper-browser.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
